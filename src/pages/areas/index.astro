---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { areas } from '../../data/areas';
import { breadcrumbSchema, businessSchema } from '../../lib/schema';

const extra = [
  'Halifax', 'Pontefract', 'Chesterfield', 'Worksop', 'Harrogate', 'Bradford', 'Hull', 'Scunthorpe',
];
---

<Base
  title="Areas we cover | Carpenter and handyman in Yorkshire | AyiTess"
  description="AyiTess is based in Barnsley and works in Sheffield, Rotherham, Doncaster, Wakefield, Leeds, Huddersfield and York. Longer moves can be booked further."
  path="/areas"
  jsonLd={[
    businessSchema(),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Areas', path: '/areas' },
    ]),
  ]}
>
  <Header />
  <main id="content" class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Areas</span>
    </nav>
    <p class="eyebrow">Local coverage</p>
    <h1>Where the crew actually goes</h1>
    <div class="prose">
      <p>
        AyiTess is based in Barnsley. The regular round is South Yorkshire and West Yorkshire, with York when a full day is booked.
        We also take calls from nearby towns. If you are in Halifax, Pontefract, Chesterfield, Worksop, Harrogate, Bradford, Hull, or Scunthorpe, ask. The answer depends on the size of the job and the day.
      </p>
      <p>
        House and office moves are different. Customers have booked AyiTess for longer runs, including a move from Liverpool to Cornwall. Those need a date, not a same-morning promise.
      </p>
    </div>
    <div class="area-grid" style="margin-top: 28px">
      {
        areas.map((area) => (
          <a class="area-card" href={`/areas/${area.slug}`}>
            <span>{area.county}</span>
            <strong>{area.name}</strong>
            <p>{area.drive}</p>
          </a>
        ))
      }
    </div>
    <h2 style="margin-top: 36px">Also ask about</h2>
    <p class="lede">{extra.join(' · ')}</p>
  </main>
  <Footer />
</Base>
