---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Page not found | AyiTess"
  description="That page is not on the AyiTess site. Go back to the home page or contact us about a job."
  path="/404"
>
  <Header />
  <main id="content" class="page">
    <p class="eyebrow">404</p>
    <h1>That page is not here</h1>
    <p class="lede">The link may be old. The work is still the same.</p>
    <p><a href="/">Back to the home page</a> · <a href="/contact">Contact us</a> · <a href="/services">Services</a></p>
  </main>
  <Footer />
</Base>
